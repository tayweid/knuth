{
  "name": "Knuth",
  "short_name": "Knuth",
  "description": "Computation workbench: .py cell documents over a live Python session",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#2b2a2d",
  "theme_color": "#2b2a2d",
  "icons": [
    {
      "src": "icons/knuth-tiles-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/knuth-tiles-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/knuth-tiles-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/x-python": [".py", ".pyi"],
        "application/x-ipynb+json": [".ipynb"],
        "text/markdown": [".md", ".markdown", ".qmd", ".rmd"],
        "application/json": [".json", ".jsonl"],
        "application/yaml": [".yaml", ".yml"],
        "text/csv": [".csv", ".tsv"],
        "text/html": [".html", ".htm"],
        "text/css": [".css"],
        "text/javascript": [".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx"],
        "text/x-sh": [".sh", ".bash", ".zsh"],
        "text/x-tex": [".tex", ".sty", ".bib"],
        "text/plain": [
          ".txt", ".text", ".log", ".ini", ".cfg", ".conf", ".toml",
          ".typ", ".r", ".jl", ".sql", ".xml", ".svg", ".rs", ".go",
          ".c", ".h", ".cpp", ".hpp", ".java", ".rb", ".lua", ".php"
        ]
      }
    }
  ]
}
