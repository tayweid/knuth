{
  "name": "Knuth",
  "short_name": "Knuth",
  "description": "Computation workbench: .py cell documents over a live Python session",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#18181a",
  "theme_color": "#18181a",
  "icons": [
    {
      "src": "icons/knuth-tiles-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/knuth-tiles-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/knuth-tiles-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/x-python": [".py", ".pyi"],
        "application/x-ipynb+json": [".ipynb"],
        "text/markdown": [".md", ".markdown", ".qmd", ".rmd"],
        "application/json": [".json", ".jsonl", ".jsonc"],
        "application/yaml": [".yaml", ".yml"],
        "text/csv": [".csv", ".tsv"],
        "text/html": [".html", ".htm"],
        "text/css": [".css", ".scss", ".sass", ".less"],
        "text/javascript": [".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx"],
        "text/x-sh": [".sh", ".bash", ".zsh", ".fish"],
        "text/x-tex": [".tex", ".sty", ".cls", ".bib"],
        "text/plain": [
          ".txt", ".text", ".rst", ".org", ".adoc", ".log", ".typ", ".diff",
          ".patch", ".toml", ".ini", ".cfg", ".conf", ".properties", ".env",
          ".xml", ".svg", ".sql", ".graphql", ".proto", ".vue", ".svelte",
          ".php", ".ps1", ".bat", ".cmake", ".gradle", ".tf", ".hcl", ".r",
          ".jl", ".m", ".do", ".ado", ".sas", ".stan", ".f90", ".c", ".h",
          ".cc", ".cpp", ".cxx", ".hpp", ".hh", ".mm", ".cs", ".java", ".kt",
          ".kts", ".scala", ".groovy", ".swift", ".go", ".rs", ".zig",
          ".nim", ".dart", ".rb", ".lua", ".pl", ".pm", ".hs", ".ml", ".mli",
          ".clj", ".lisp", ".el", ".scm", ".erl", ".ex", ".exs"
        ]
      }
    }
  ]
}
