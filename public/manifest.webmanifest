{
  "name": "Knuth",
  "short_name": "Knuth",
  "description": "Computation workbench: .py cell documents over a live Python session",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#22252b",
  "theme_color": "#22252b",
  "icons": [
    { "src": "icons/knuth-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/knuth-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/knuth-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/x-python": [".py"]
      }
    }
  ]
}
