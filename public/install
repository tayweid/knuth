#!/bin/bash
# Install or update Knuth.app:
#
#   curl -fsSL https://knuth.tayweid.io/install | bash
#
# This file ships with the site (public/install). Every deploy builds the
# app on a Mac and publishes it beside the site as app/Knuth-<arch>.zip
# (.github/workflows/deploy.yml), so this always installs the site's current
# version, and running it again updates. Needs nothing but macOS 13; the app
# asks about Python on its first launch (docs/APP.md).
#
# The zip is the app without Electron's framework (Chromium, 286 MB). The
# app's own complete.sh puts it in: cloned from an installed Claerbout app
# on the same Electron version — Knuth itself when updating, Plass or
# ManimLive otherwise — which on APFS costs no disk space; with none,
# Electron's release is downloaded from GitHub and checked against its
# published SHA-256 sums (APP.md, "Electron, one shell for Claerbout"). The
# same zip from the page's download button completes itself on first launch.
#
# Overrides, for testing: KNUTH_SITE (a URL or a local folder holding
# app/Knuth-<arch>.zip), KNUTH_APP (the .app to write), KNUTH_SIBLINGS
# (folders to look in for a sibling, instead of the Applications folders;
# empty means none), ELECTRON_MIRROR (where Electron's releases are).
set -euo pipefail

site="${KNUTH_SITE:-https://knuth.tayweid.io}"

die() { printf 'Knuth install: %s\n' "$*" >&2; exit 1; }
[ "$(uname -s)" = "Darwin" ] || die "Knuth.app is for macOS. Elsewhere, see https://github.com/tayweid/knuth#readme for pip."
case "$(uname -m)" in
    arm64) arch=arm64 ;;
    x86_64) arch=x64 ;;
    *) die "no Knuth.app for this processor ($(uname -m))." ;;
esac

if [ -n "${KNUTH_APP:-}" ]; then
    app="$KNUTH_APP"
elif [ -w /Applications ]; then
    app="/Applications/Knuth.app"
else
    mkdir -p "$HOME/Applications"
    app="$HOME/Applications/Knuth.app"
fi
mkdir -p "$(dirname "$app")"
# Replacing the bundle of a running app pulls it out from under the windows
# it opens next.
# (macOS may report a path under /private without that prefix.)
if pgrep -f "^(/private)?${app#/private}/Contents/MacOS/" >/dev/null 2>&1; then
    die "Knuth is open. Quit it (Knuth menu → Quit Knuth), then run this again."
fi

# The new app is put together beside the old one, so a sibling is judged on
# the right volume, and replaces it only once complete.
incoming="$app.incoming"
work="$(mktemp -d)"
trap 'rm -rf "$work" "$incoming"' EXIT

echo "Knuth: downloading (about 3 MB)…"
fetch() { # fetch <url-or-path> <file>
    case "$1" in
        http*) curl -fsSL -o "$2" "$1" ;;
        *) cp "$1" "$2" ;;
    esac
}
fetch "$site/app/Knuth-$arch.zip" "$work/Knuth.zip" \
    || die "could not download Knuth — check the connection and run this again."
ditto -x -k "$work/Knuth.zip" "$work"
rm -rf "$incoming"
mv "$work/Knuth.app" "$incoming"
new="$incoming"
[ -x "$new/Contents/Resources/complete.sh" ] || die "the download was incomplete — run this again."
# Apple silicon runs only signed code; Electron's x64 release, and so this
# app on an Intel Mac, is unsigned. The seal is the app as it ships.
if [ "$arch" = arm64 ]; then
    codesign --verify --strict "$new" 2>/dev/null || die "the download does not verify — run this again."
fi

# The app completes itself with the script it carries: Electron cloned from
# the app this replaces or another Claerbout app, else downloaded once.
if [ -n "${KNUTH_SIBLINGS+set}" ]; then export CLAERBOUT_SIBLINGS="$KNUTH_SIBLINGS"; fi
echo "Knuth: getting Electron (shared with another Claerbout app if one has it, else about 130 MB, once)…"
"$new/Contents/Resources/complete.sh" "$new" /dev/null "$app" \
    || die "could not get Electron — check the connection and run this again."

rm -rf "$app"
mv "$new" "$app" || die "could not move Knuth into place — run this again."
echo "Knuth: installed $app — open it from $(dirname "$app")."
