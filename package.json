{
  "name": "knuth",
  "private": true,
  "version": "2.0.0-dev",
  "license": "MIT",
  "type": "module",
  "description": "Computation workbench of the Claerbout suite: .py cell documents with a live session, auto-persisted values and figures",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:engine": "npm run build && node scripts/stage-web.mjs",
    "preview": "vite preview",
    "check:web": "node scripts/check-web-fresh.mjs",
    "test": "node --import tsx src/format/round-trip.test.ts && node --import tsx src/kernel/protocol.test.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "markdown-it": "^15.0.0"
  }
}
