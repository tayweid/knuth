{
  "name": "Knuth",
  "short_name": "Knuth",
  "description": "Computation workbench: .py cell documents over a live Python session",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#2b2a2d",
  "theme_color": "#2b2a2d",
  "icons": [
    {
      "src": "icons/knuth-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/knuth-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/knuth-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/x-python": [
          ".py"
        ],
        "application/x-ipynb+json": [
          ".ipynb"
        ]
      }
    }
  ]
}
