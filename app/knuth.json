{
  "name": "Knuth",
  "id": "io.tayweid.knuth",
  "envPrefix": "KNUTH",
  "package": "knuth",
  "devPython": "../python",
  "site": "https://knuth.tayweid.io",
  "elsewhere": "Elsewhere, see https://github.com/tayweid/knuth#readme for pip.",
  "port": 5187,
  "pythons": ["uv", "browser"],
  "scheme": "knuth",
  "setupPage": "setup.html",
  "defaultDocument": "Knuth.py",
  "autosave": true,
  "engine": {
    "args": ["-m", "knuth", "serve"],
    "marker": "server.py",
    "probe": "knuth",
    "python": "3.13",
    "requirements": ["websockets>=14.0", "openpyxl>=3.1"]
  },
  "window": {
    "width": 1100,
    "height": 760,
    "minWidth": 520,
    "minHeight": 360,
    "titleBarStyle": "hiddenInset",
    "trafficLightPosition": { "x": 14, "y": 15 },
    "zoom": "page",
    "//": "zoom: the View menu's Zoom In / Out / Actual Size tell the page (shell 0.2.11), which zooms the column alone (src/column-zoom.ts); the bar, the rail and the cards beside the column keep their size."
  },
  "icon": "../python/knuth/web/icons/knuth-tiles-512.png",
  "copyright": "© 2026 Taylor J Weidman. MIT License.",
  "smoke": {
    "document": "smoke.py",
    "text": "# %%\nanswer = 41 + 1\n",
    "ready": "#kernel-status",
    "readyText": { "uv": "uv", "browser": "Pyodide" },
    "run": "#run-all",
    "written": "values.json",
    "json": { "answer": 42 },
    "autosave": ["knuth: session open", "knuth: cell run [1]"],
    "history": "#history-tile",
    "room": "#layout"
  },
  "documentTypes": [
    { "name": "Python cell document", "role": "Editor", "rank": "Alternate", "contentTypes": ["public.python-script"], "extensions": ["py"] },
    { "name": "Jupyter notebook", "role": "Viewer", "rank": "Alternate", "extensions": ["ipynb"] },
    { "name": "Excel workbook", "role": "Viewer", "rank": "Alternate", "extensions": ["xlsx", "xlsm"] },
    {
      "name": "Source code",
      "role": "Editor",
      "rank": "Alternate",
      "//": "src/plain-file.ts's TEXT_EXTENSIONS, by extension: the system's own type where it has one (.c is public.c-source), else the extension (.rs). .ts is the system's MPEG-2 video, which an app's declaration cannot change (tried 2026-10-16), so Knuth is offered for those too.",
      "extensions": [
        "txt", "text", "md", "markdown", "qmd", "rmd", "rst", "org", "adoc", "log", "tex",
        "sty", "cls", "bib", "typ", "diff", "patch", "json", "jsonl", "jsonc", "yaml", "yml",
        "toml", "ini", "cfg", "conf", "properties", "env", "csv", "tsv", "xml", "svg", "sql",
        "graphql", "proto", "html", "htm", "css", "scss", "sass", "less", "js", "mjs", "cjs",
        "jsx", "ts", "tsx", "vue", "svelte", "php", "sh", "bash", "zsh", "fish", "ps1",
        "bat", "cmake", "gradle", "tf", "hcl", "pyi", "r", "jl", "m", "do", "ado", "sas",
        "stan", "f90", "c", "h", "cc", "cpp", "cxx", "hpp", "hh", "mm", "cs", "java", "kt",
        "kts", "scala", "groovy", "swift", "go", "rs", "zig", "nim", "dart", "rb", "lua",
        "pl", "pm", "hs", "ml", "mli", "clj", "lisp", "el", "scm", "erl", "ex", "exs"
      ]
    },
    { "name": "Text file", "role": "Editor", "rank": "Alternate", "contentTypes": ["public.plain-text"] }
  ],
  "defaultFor": {
    "name": "code",
    "//": "Knuth › Make Knuth the Default Editor… (shell 0.2.14): \"Source code\" above less the prose and data other apps keep on Taylor's Mac (txt text md markdown qmd rmd rst org adoc log typ: Plass and TextEdit; html htm svg xml: the browsers). csv and tsv are Knuth's, its grid (Taylor, 2026-10-16). .ts is also the system's MPEG-2 video, so Knuth takes that type too. macOS 26.4+ confirms each type it changes in a prompt of its own; only those another app opens are changed.",
    "extensions": [
      "tex", "sty", "cls", "bib", "diff", "patch", "json", "jsonl", "jsonc", "yaml", "yml",
      "toml", "ini", "cfg", "conf", "properties", "env", "csv", "tsv", "sql", "graphql", "proto", "css",
      "scss", "sass", "less", "js", "mjs", "cjs", "jsx", "ts", "tsx", "vue", "svelte", "php",
      "sh", "bash", "zsh", "fish", "ps1", "bat", "cmake", "gradle", "tf", "hcl", "pyi", "r",
      "jl", "m", "do", "ado", "sas", "stan", "f90", "c", "h", "cc", "cpp", "cxx", "hpp", "hh",
      "mm", "cs", "java", "kt", "kts", "scala", "groovy", "swift", "go", "rs", "zig", "nim",
      "dart", "rb", "lua", "pl", "pm", "hs", "ml", "mli", "clj", "lisp", "el", "scm", "erl",
      "ex", "exs"
    ]
  }
}
