{
  "name": "Knuth",
  "id": "io.tayweid.knuth",
  "envPrefix": "KNUTH",
  "package": "knuth",
  "devPython": "../python",
  "site": "https://knuth.tayweid.io",
  "elsewhere": "Elsewhere, see https://github.com/tayweid/knuth#readme for pip.",
  "port": 5187,
  "pythons": ["uv", "browser"],
  "scheme": "knuth",
  "setupPage": "setup.html",
  "defaultDocument": "Knuth.py",
  "autosave": true,
  "engine": {
    "args": ["-m", "knuth", "serve"],
    "marker": "server.py",
    "probe": "knuth",
    "python": "3.13",
    "requirements": ["websockets>=14.0"]
  },
  "window": {
    "width": 1100,
    "height": 760,
    "minWidth": 520,
    "minHeight": 360,
    "titleBarStyle": "hiddenInset",
    "trafficLightPosition": { "x": 14, "y": 15 },
    "//": "No followZoom, on purpose: that is for a page laid out as a fixed-width paper (Plass). Knuth's room is fluid (the column has a max-width and rewraps), so a zoom step rewraps it inside the same window; the bar still follows the lights' band through env(titlebar-area-height)."
  },
  "icon": "../python/knuth/web/icons/knuth-tiles-512.png",
  "copyright": "© 2026 Taylor J Weidman. MIT License.",
  "smoke": {
    "document": "smoke.py",
    "text": "# %%\nanswer = 41 + 1\n",
    "ready": "#kernel-status",
    "readyText": { "uv": "uv", "browser": "Pyodide" },
    "run": "#run-all",
    "written": "values.json",
    "json": { "answer": 42 },
    "autosave": ["knuth: session open", "knuth: cell run [1]"],
    "history": "#history-tile",
    "room": "#layout"
  },
  "documentTypes": [
    { "name": "Python cell document", "role": "Editor", "rank": "Alternate", "contentTypes": ["public.python-script"], "extensions": ["py"] },
    { "name": "Jupyter notebook", "role": "Viewer", "rank": "Alternate", "extensions": ["ipynb"] },
    { "name": "Text file", "role": "Editor", "rank": "None", "contentTypes": ["public.plain-text", "public.comma-separated-values-text"] }
  ]
}
